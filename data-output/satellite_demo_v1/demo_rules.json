{
  "schema_version": "1.0",
  "provenance": "demonstration_assumptions_not_industry_standard",
  "availability": {
    "object": "end_to_end_service_from_source_satellite_to_fixed_ground_station",
    "formula": "100 * probe_successes / probe_attempts",
    "unit": "percent_0_100",
    "baseline": "per_service_mean_over_case_baseline_window",
    "drop_unit": "percentage_points_not_relative_percent",
