DATABASE_URL=postgresql+psycopg://ontology:ontology@localhost:5432/ontology_ai
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# === LLM（可选；rule-based 不需要）===
LLM_PROVIDER=rule-based
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# === 飞书 (Lark) — 真实集成 ===
# 留空 = 走 mock 降级；填齐 = 调真实飞书 API
# App ID / App Secret 在飞书开放平台 https://open.feishu.cn 应用的「凭证与基础信息」里
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 审批模板编码 + 默认审批人 + 控件 ID（这些是公开模板配置，不是密钥，可入库）
FEISHU_APPROVAL_CODE=DE79D47F-CC81-4044-B7CC-F40CC8942751
FEISHU_DEFAULT_APPROVER=ou_727be3e59a667917446ccaa76f29e175
FEISHU_FORM_TITLE_ID=widget16500094298477484625790733479
FEISHU_FORM_CONTENT_ID=widget16500094292359699894458073106

# 是否启动 WebSocket 事件监听（关闭后只能走轮询）
FEISHU_EVENT_ENABLED=true